{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(opengraph-image|twitter-image|apple-icon)",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    },
    {
      "source": "/pass/(opengraph-image|twitter-image)",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    },
    {
      "source": "/pass/:number/(opengraph-image|twitter-image)",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    }
  ]
}
