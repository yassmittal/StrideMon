#!/usr/bin/env bash
#
# Readies wallets A and B for the demo (docs/demo-script.md, D-033): tops wallet A up to
# its next upgrade plus a repair in SOLE, and both wallets to 1 MON if below 0.5.
# Needs DEMO_WALLET_A_ADDRESS and DEMO_WALLET_B_ADDRESS in packages/contracts/.env.
#
#   scripts/prepare-demo-wallets [--dry-run]

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/demo-env.sh"

forge script script/PrepareDemoWallets.s.sol "${FORGE_SCRIPT_FLAGS[@]}"
