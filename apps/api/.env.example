# Copy to .env and adjust. Every variable here is required; the API refuses to
# boot and names the missing one otherwise.

NODE_ENV=development
API_PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27019/stridemon

# Signs access tokens (HS256). At least 64 characters; generate with: openssl rand -hex 64
JWT_ACCESS_TOKEN_SECRET=replace-me-with-the-output-of-openssl-rand-hex-64-replace-me-with-the-output-of-openssl-rand
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Must equal the domain in the SIWE message the API builds. The app never sends its own.
SIWE_DOMAIN=stridemon.com

# Used to verify SIWE signatures (and, from Phase 3, to send game-server transactions).
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
