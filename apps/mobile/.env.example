# Copy to .env. Everything prefixed EXPO_PUBLIC_ is compiled into the app and is
# PUBLIC: never put a secret here.

# A phone can't reach "localhost" on your laptop. Use the laptop's LAN IP
# (the API logs it on boot: "Server listening at http://192.168.x.x:3000").
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.3:3000

# Monad testnet. Selects contract addresses from @stridemon/chain; the RPC serves wallet reads.
EXPO_PUBLIC_MONAD_CHAIN_ID=10143
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# From https://cloud.reown.com (free). Public by design: it identifies the app to WalletConnect.
EXPO_PUBLIC_REOWN_PROJECT_ID=00000000000000000000000000000000
